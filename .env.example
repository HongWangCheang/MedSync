# Copy to .env and fill in. .env is git-ignored.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
POSTGRES_PASSWORD=change-me-pg
# Needed for the pharmacist step (services/rag answers medication questions with Gemini)
GEMINI_API_KEY=
# Shared by agent and rag to sign session owners. Any long random string: openssl rand -hex 32
MEDSYNC_INTERNAL_SECRET=
